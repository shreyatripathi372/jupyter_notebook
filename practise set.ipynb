    "def cal_sum(lst):\n",
    "    total = 0\n",
    "    for i in lst:\n",
    "        total = total + i\n",
    "    return total\n",
    "\n",
    "print(cal_sum([8, 2, 3, 0, 7]))\n"
   ]
